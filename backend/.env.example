# Backend Environment Variables

# MongoDB Connection (Required)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/EasyXpense?retryWrites=true&w=majority

# JWT Secret Key (Required) - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production

# Flask Configuration
FLASK_ENV=production
PORT=10000

# Client URL (Frontend)
CLIENT_URL=https://easyxpense.netlify.app

# Token Expiry (seconds)
ACCESS_TOKEN_EXPIRES=86400
REFRESH_TOKEN_EXPIRES=604800